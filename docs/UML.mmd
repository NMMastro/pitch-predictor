        TAB["tabular_features.py<br/><i>pitcher / batter mixes, previous<br/>pitches, at-bat, workload</i>"]
        SEQ["sequence_features.py<br/><i>shifted codes, pad mask, first-pitch flags,<br/>train-only scalers, seq + ctx arrays (in memory)</i>"]
    end

    subgraph MODELS["src/models/tabular/ — tabular models (EXISTS)"]
        BL["baselines.py<br/><i>league mix + pitcher mixes<br/>(career, last200, vs_hand, count),<br/>no training</i>"]
