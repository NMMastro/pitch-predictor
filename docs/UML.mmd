    subgraph RETRIEVAL["src/data-retrieval/ — acquire & subset (EXISTS)"]
        FS["fetch_seasons.py<br/><i>bulk pull, month chunking,<br/>resumable → data/raw/</i>"]
        FST["fetch_statcast.py<br/><i>single date-range pull</i>"]
