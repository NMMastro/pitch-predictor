        LR["logreg.py<br/><i>logistic regression</i>"]
        XGB["xgb.py<br/><i>XGBoost</i>"]
    end

    subgraph EVAL["src/evaluation/ — scoring (EXISTS)"]
        MET["metrics.py<br/><i>evaluate(), align_proba(),<br/>log_run(), load_scoreboard()</i>"]
    end

